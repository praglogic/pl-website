---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { ShieldCheck, Scale, GitBranch, Stethoscope, Code2, Users, Flag, FileCheck } from 'lucide-astro';
---

<Layout
  title="Praglogic — Deterministic AI for outcomes that matter"
  description="Praglogic builds deterministic AI for domains where probabilistic answers aren't good enough. Two products: Auravera (therapeutic AI for assisted living) and EmbedIQ (compliance-aware configuration for Claude Code, Cursor, Copilot, Gemini CLI, Windsurf, and AGENTS.md)."
>
  <Navigation />

  <!-- Hero -->
  <section class="hero" role="banner" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-content">
        <h1 id="hero-title" class="hero-title">
          AI for outcomes
          <span class="hero-emphasis">that matter.</span>
        </h1>
        <p class="hero-subtitle">
          We build deterministic AI for domains where probabilistic answers aren't good enough — elderly mental health and enterprise engineering. Two products. One engineering principle.
        </p>
        <div class="hero-actions">
          <a href="/products/" class="btn-primary-large">Explore products</a>
          <a href="/contact" class="btn-secondary-large">Get in touch</a>
        </div>
      </div>
      <div class="hero-visual">
        <img src="/images/pl_hero.png" alt="Praglogic — technology and people collaborating across healthcare, agriculture, research, and education" class="hero-img" />
      </div>
    </div>
  </section>

  <!-- Thesis -->
  <section class="thesis" role="region" aria-labelledby="thesis-heading">
    <div class="container thesis-inner">
      <h2 id="thesis-heading" class="thesis-heading">We build what we can prove.</h2>
      <p class="thesis-body">
        LLMs are good at fluency. They are not, on their own, good enough for decisions where a missed call costs a life or breaks an audit. Our engineering principle is to reach for determinism — explicit rules, reproducible outputs, auditable pathways — in the places where failure is unacceptable, and to use LLMs where they genuinely help. That posture runs through everything we ship.
      </p>
    </div>
  </section>

  <!-- Products -->
  <section class="products" role="region" aria-labelledby="products-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="products-heading">What we build.</h2>
        <p>Two products in very different domains, built on the same principle.</p>
      </div>
      <div class="product-grid">
        <article class="product-card">
          <div class="product-card-top">
            <span class="product-badge product-badge-auravera">Pre-pilot · recruiting facilities for Q3 2026</span>
            <h3 class="product-card-title">Auravera</h3>
            <p class="product-card-tag">Therapeutic AI companion for assisted living.</p>
          </div>
          <p class="product-card-body">
            A deterministic safety pipeline designed to surface and de-escalate mental-health crises in elderly residents. Voice-first, on-device or cloud, with every safety decision traceable.
          </p>
          <ul class="product-card-proof">
            <li>100% crisis recall on internal 500-test safety suite</li>
            <li>Multimodal voice + text emotion analysis; 13 clinical instruments integrated</li>
            <li>Cloud SaaS, on-premise, or edge — data-sovereignty options</li>
          </ul>
          <a href="/products/auravera/" class="product-card-link" aria-label="Learn more about Auravera">
            Learn more <span aria-hidden="true">→</span>
          </a>
        </article>

        <article class="product-card">
          <div class="product-card-top">
            <span class="product-badge product-badge-embediq">Shipped · v3.2 · MIT license</span>
            <h3 class="product-card-title">EmbedIQ</h3>
            <p class="product-card-tag">Compliance-aware configuration for every AI coding agent on your team.</p>
          </div>
          <p class="product-card-body">
            An adaptive Q&amp;A wizard that generates the full config for Claude Code, Cursor, GitHub Copilot, Gemini CLI, Windsurf, and cross-agent <code>AGENTS.md</code> &mdash; from a single structured interview. Deterministic, byte-for-byte reproducible, no runtime LLM.
          </p>
          <ul class="product-card-proof">
            <li>71 adaptive questions across 7 dimensions</li>
            <li>17 generators, 6 agent formats, 15–40 config files</li>
            <li>3 compliance packs: healthcare (HIPAA), finance (PCI-DSS), education (FERPA)</li>
          </ul>
          <div class="product-card-links">
            <a href="/products/embediq/" class="product-card-link" aria-label="Learn more about EmbedIQ">
              Learn more <span aria-hidden="true">→</span>
            </a>
            <a href="https://github.com/asq-sheriff/embediq" class="product-card-link-secondary" target="_blank" rel="noopener" aria-label="EmbedIQ on GitHub">
              View on GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Deterministic by design -->
  <section class="determinism pl-dark-band pl-dark-glow" role="region" aria-labelledby="determinism-heading">
    <div class="container">
      <div class="section-header section-header-dark">
        <h2 id="determinism-heading">Deterministic by design.</h2>
        <p>Why the same principle shows up in both products.</p>
      </div>
      <div class="determinism-grid">
        <div class="det-card">
          <div class="det-icon"><GitBranch size={28} strokeWidth={1.5} /></div>
          <h3>Reproducible outputs</h3>
          <p>Same inputs, same outputs. Byte-for-byte for EmbedIQ configurations — verified by a golden-config replay scorer. Documented routing through the crisis-detection pipeline for Auravera. Nothing that matters depends on a temperature setting.</p>
        </div>
        <div class="det-card">
          <div class="det-icon"><FileCheck size={28} strokeWidth={1.5} /></div>
          <h3>Auditable pathways</h3>
          <p>Every decision traceable to the rule or gate that produced it. Required for FDA De Novo and HIPAA and the audit packages our customers actually have to ship. Also how we'd build either way.</p>
        </div>
        <div class="det-card">
          <div class="det-icon"><ShieldCheck size={28} strokeWidth={1.5} /></div>
          <h3>No black-box AI for safety calls</h3>
          <p>LLMs help with fluency, phrasing, and user experience. Determinism runs the safety-critical pipeline — the crisis gate, the compliance enforcement, the permission tier. No probabilistic hope where the stakes don't allow it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest stage reporting -->
  <section class="stage" role="region" aria-labelledby="stage-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="stage-heading">Built with honesty about stage.</h2>
        <p>What is true today. We flag the rest as roadmap.</p>
      </div>
      <div class="stage-grid">
        <div class="stage-stat">
          <div class="stage-icon"><Code2 size={24} strokeWidth={1.5} /></div>
          <div class="stage-headline">EmbedIQ shipped</div>
          <div class="stage-body">v3.2 released April 22, 2026. Multi-agent targeting: Claude Code, Cursor, Copilot, Gemini, Windsurf, AGENTS.md. MIT-licensed, Docker/Kubernetes, enterprise ops (autopilot, drift, git PR, webhooks).</div>
        </div>
        <div class="stage-stat">
          <div class="stage-icon"><Stethoscope size={24} strokeWidth={1.5} /></div>
          <div class="stage-headline">Auravera pre-pilot</div>
          <div class="stage-body">Engineering validation complete. FDA De Novo submission targeted Q4 2026; feasibility study recruiting for summer 2026.</div>
        </div>
        <div class="stage-stat">
          <div class="stage-icon"><Scale size={24} strokeWidth={1.5} /></div>
          <div class="stage-headline">13 clinical instruments</div>
          <div class="stage-body">Scoring implementations aligned to published protocols — PHQ-9, GAD-7, C-SSRS, GDS-15, UCLA-3, WHO-5, and more.</div>
        </div>
        <div class="stage-stat">
          <div class="stage-icon"><Flag size={24} strokeWidth={1.5} /></div>
          <div class="stage-headline">Patent pending</div>
          <div class="stage-body">U.S. provisional patent filed May 27, 2026, covering our deterministic crisis-detection and multimodal-inference methods.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="audience" role="region" aria-labelledby="audience-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="audience-heading">Who we work with.</h2>
        <p>Three conversations we are actively having today.</p>
      </div>
      <div class="audience-grid">
        <a class="audience-card" href="/contact?interest=auravera-pilot">
          <div class="audience-icon"><Stethoscope size={28} strokeWidth={1.5} /></div>
          <h3>Assisted living operators</h3>
          <p>Recruiting 2–3 facility partners for the Auravera feasibility study (n=20). Free to the partner; we provide hardware, support, and the IRB package.</p>
          <span class="audience-cta">Start a pilot conversation →</span>
        </a>
        <a class="audience-card" href="/contact?interest=embediq">
          <div class="audience-icon"><Code2 size={28} strokeWidth={1.5} /></div>
          <h3>Enterprise engineering teams</h3>
          <p>For teams in regulated industries running AI coding agents across multiple projects. EmbedIQ is MIT-licensed and on GitHub — we'll walk you through enterprise deployment, autopilot, drift detection, and compliance-platform integration (Drata / Vanta).</p>
          <span class="audience-cta">Start an enterprise conversation →</span>
        </a>
        <a class="audience-card" href="/contact?interest=collaborate">
          <div class="audience-icon"><Users size={28} strokeWidth={1.5} /></div>
          <h3>Clinical advisors, researchers, investors</h3>
          <p>Geriatric psychiatry, deterministic AI safety, and regulated-industry tooling. We are building an advisory board and welcome conversations about the science and the company.</p>
          <span class="audience-cta">Reach out →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="cta-section" role="region" aria-labelledby="cta-heading">
    <div class="container">
      <div class="cta-content">
        <h2 id="cta-heading">Let's build systems that earn the trust they claim.</h2>
        <p>If what we're building sounds like the posture your organization needs, we'd like to hear from you.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn-primary-large">Get in touch</a>
          <a href="/products/" class="btn-secondary-large">Explore products</a>
        </div>
        <div class="cta-contact">
          <p>Or email us directly at <a href="mailto:contact@pragmaticlogic.ai">contact@pragmaticlogic.ai</a></p>
        </div>
      </div>
    </div>
  </section>

  <button class="back-to-top" aria-label="Back to top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
    <span class="back-to-top-icon" aria-hidden="true">↑</span>
  </button>

  <Footer />
</Layout>

<style>
  /* ==========================================
     HERO
     ========================================== */
  .hero {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: var(--space-20) 0 var(--space-16);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero-content {
    max-width: 560px;
  }

  .hero-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 300;
    line-height: 1.2;
    margin: 0 0 var(--space-6) 0;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .hero-emphasis {
    display: block;
    margin-top: var(--space-2);
    font-weight: 600;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-8) 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-img {
    width: 100%;
    max-width: 540px;
    height: auto;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      text-align: center;
    }
    .hero-content { max-width: 100%; margin: 0 auto; }
    .hero-visual { order: -1; }
    .hero-actions { justify-content: center; }
  }

  /* ==========================================
     BUTTONS
     ========================================== */
  .btn-primary-large,
  .btn-secondary-large {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-xl);
    font-weight: 600;
    font-size: var(--font-size-base);
    text-decoration: none;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }

  .btn-primary-large {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary-large:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .btn-secondary-large {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn-secondary-large:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* ==========================================
     SECTION HEADER (shared)
     ========================================== */
  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--space-12);
  }

  .section-header h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 var(--space-3) 0;
    letter-spacing: -0.02em;
  }

  .section-header p {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .section-header-dark h2 { color: var(--color-premium-dark-text); }
  .section-header-dark p { color: var(--color-premium-dark-muted); }

  /* ==========================================
     THESIS BAND
     ========================================== */
  .thesis {
    padding: var(--space-16) 0;
    background: #fbfbfd;
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }

  .thesis-inner { max-width: 820px; text-align: center; }

  .thesis-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    margin: 0 0 var(--space-4) 0;
    letter-spacing: -0.02em;
  }

  .thesis-body {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ==========================================
     PRODUCTS
     ========================================== */
  .products { padding: var(--space-20) 0; }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  @media (max-width: 900px) {
    .product-grid { grid-template-columns: 1fr; }
  }

  .product-card {
    background: white;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-2xl);
    padding: var(--space-10);
    transition: all 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .product-card-top { margin-bottom: var(--space-5); }

  .product-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-4);
  }

  .product-badge-auravera {
    background: rgba(245, 158, 11, 0.12);
    color: #b45309;
  }

  .product-badge-embediq {
    background: rgba(16, 185, 129, 0.12);
    color: #047857;
  }

  .product-card-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.02em;
  }

  .product-card-tag {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
    font-weight: 500;
  }

  .product-card-body {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-5) 0;
  }

  .product-card-proof {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .product-card-proof li {
    padding-left: var(--space-5);
    position: relative;
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: 1.5;
  }

  .product-card-proof li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .product-card-links {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .product-card-link {
    font-weight: 600;
    color: var(--color-primary);
    font-size: var(--font-size-base);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s ease;
  }

  .product-card-link:hover { gap: 10px; color: var(--color-primary-dark); }

  .product-card-link-secondary {
    font-weight: 500;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  .product-card-link-secondary:hover {
    color: var(--color-primary);
  }

  .product-card-body code {
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.92em;
    background: var(--color-background-secondary, #f1f5f9);
    padding: 1px 5px;
    border-radius: 4px;
  }

  /* ==========================================
     DETERMINISM (dark band)
     ========================================== */
  .determinism { padding: var(--space-20) 0; }

  .determinism-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .determinism-grid { grid-template-columns: 1fr; }
  }

  .det-card {
    padding: var(--space-8);
    background: var(--color-premium-dark-surface);
    border: 1px solid var(--color-premium-dark-hairline);
    border-radius: var(--radius-xl);
  }

  .det-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background: rgba(37, 99, 235, 0.18);
    color: #93c5fd;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .det-card h3 {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-premium-dark-text);
    margin: 0 0 var(--space-3) 0;
    letter-spacing: -0.01em;
  }

  .det-card p {
    color: var(--color-premium-dark-muted);
    margin: 0;
    line-height: 1.65;
    font-size: var(--font-size-base);
  }

  /* ==========================================
     HONEST STAGE
     ========================================== */
  .stage {
    padding: var(--space-20) 0;
    background: #fbfbfd;
  }

  .stage-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  @media (max-width: 1024px) { .stage-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .stage-grid { grid-template-columns: 1fr; } }

  .stage-stat {
    padding: var(--space-6);
    background: white;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
  }

  .stage-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-primary-subtle);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .stage-headline {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    letter-spacing: -0.01em;
  }

  .stage-body {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* ==========================================
     AUDIENCE
     ========================================== */
  .audience { padding: var(--space-20) 0; }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .audience-grid { grid-template-columns: 1fr; }
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    background: white;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: inherit;
    transition: all 0.25s ease;
  }

  .audience-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .audience-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-primary-subtle), rgba(16, 185, 129, 0.08));
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .audience-card h3 {
    font-size: var(--font-size-xl);
    font-weight: 600;
    margin: 0 0 var(--space-3) 0;
    letter-spacing: -0.01em;
  }

  .audience-card p {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--space-4) 0;
    font-size: var(--font-size-base);
    flex: 1;
  }

  .audience-cta {
    font-weight: 600;
    color: var(--color-primary);
    font-size: var(--font-size-base);
  }

  /* ==========================================
     CTA
     ========================================== */
  .cta-section {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    padding: var(--space-20) 0;
  }

  .cta-content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin: 0 0 var(--space-4) 0;
    letter-spacing: -0.02em;
  }

  .cta-content > p {
    font-size: var(--font-size-lg);
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 var(--space-8) 0;
    line-height: 1.5;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-4);
